<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup/transfer rules. HelloHealth stores sensitive health data
    (Health Connect readings, mood, nutrition) in its Room DB plus auth tokens; none of it should
    leave the device via Google cloud backup or device-to-device transfer. allowBackup is already
    false in the manifest; these rules are the explicit belt-and-suspenders for both channels.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
